{
  "name": "bigvoodoo/bvi-mega-menu",
  "description": "Enhanced WordPress navigation menu with mega menu, related links, columns, shortcodes, and block editor support.",
  "type": "wordpress-plugin",
  "license": "GPLv3",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.11"
  },
  "autoload": {
    "psr-4": {
      "Bvi\\Plugin\\MegaMenu\\": "src/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "test": "phpunit",
    "check": [
      "@lint",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2.99"
    }
  },
  "authors": [
    {
      "name": "Christina Gleason",
      "email": "chris@bigvoodoo.com"
    }
  ]
}
