{
  "apiVersion": 3,
  "name": "bvi/related-links",
  "version": "5.0.0",
  "title": "Related Links",
  "category": "widgets",
  "icon": "editor-ul",
  "description": "Display related links from a mega menu. Auto-detects on page menu or falls back to default.",
  "keywords": ["links", "related", "sidebar", "navigation"],
  "supports": {
    "html": false,
    "className": true,
    "color": {
      "text": true,
      "background": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "fontWeight": true,
      "fontStyle": true,
      "textTransform": true,
      "textDecoration": true,
      "letterSpacing": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    }
  },
  "textdomain": "bvi-mega-menu",
  "attributes": {
    "menuSlug": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js"
}
